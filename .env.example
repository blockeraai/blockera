APP_MODE=production
TELEMETRY_SERVER_URL=http://127.0.0.1:8000/v1/telemetry
BLOCKERA_TELEMETRY_OPT_IN_OFF=false
WP_TESTS_DIR=/Users/User/Desktop/workflow/wordpress-develop/tests/phpunit/
DB=wp_tests
WP_ENV_CONFIG=development
# Local wp-env port (ignored in CI). Same map in every product:
#   blockera 8850 · blockera-pro 8851 · blockera-one 8852 · blockera-site-toolkit 8853
WP_ENV_PORT=8850
# https://api.test is a Laravel app that provides a REST API.
CONNECT_ACCOUNT_URL=https://api.test/authorize
# Replacements for https://blockera.ai
CREATE_ACCOUNT_URL=https://blockeraai.test/my-account/license-manager
ACCESS_TOKEN_URL=https://api.test/auth/v1/access-token
ACCOUNT_INFO_URL=https://blockeraai.test/wp-json/auth/v1/licenses
UNSUBSCRIBE_URL=https://blockeraai.test/wp-json/auth/v1/license/delete
GET_ZIP_FILE_URL=https://blockeraai.test/auth/v1/license/get-zip-file
API_BASE_URL=https://api.test
ALLOWED_PLANS_URL=https://blockeraai.test/wp-json/auth/v1/products/allowed-plans
RESOURCE_OWNER_DETAILS_URL=https://api.test/files/v1/download
REFRESH_TOKEN_URL=https://api.test/auth/v1/refresh-token
# Active plugin or theme slug: PHP autoload and shared GP JS/CSS enqueue from that product.
BLOCKERA_COORDINATOR_REF=blockera
BLOCKERA_EXTERNAL_SOURCE_CODES_PATH=/absolute/path/to/shared/source-codes
