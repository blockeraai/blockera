# Edit packages/global-packages/packages/dev-tools/root-configs/.gitignore.blockera
# project:bootstrap prepends these extras, then the shared gitignore.

# Shared packages live in the sparse submodule packages/global-packages.
# Only index.php is owned by this repo under packages/.
/packages/*
!/packages/index.php
!/packages/global-packages

# Shared gitignore — edit packages/global-packages/packages/dev-tools/root-configs/.gitignore
# project:bootstrap copies this section to every product.

