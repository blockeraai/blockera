// Edit packages/global-packages/packages/dev-tools/root-configs/tsconfig.json.template
// project:bootstrap generates host tsconfig.json from this file and adds
// exclude entries for GP packages not in package.json dependencies.
{
	"extends": "./packages/global-packages/packages/dev-tools/js/typescript/tsconfig.base.json",
	"include": [
		"packages/**/js/**/*.ts",
		"packages/**/js/**/*.tsx",
		"packages/global-packages/packages/dev-tools/types/**/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"build",
		"dist",
		"source-codes",
		"packages/global-packages/packages/dev-playwright"
	]
}
