{
	"name": "blockera/plugin",
	"description": "A Blockera Site Editor experience base on Gutenberg core modules.",
	"type": "library",
	"license": "ISC",
	"repositories": [
		{
			"type": "path",
			"url": "packages/global-packages/packages/*",
			"options": {
				"symlink": true
			}
		},
		{
			"type": "path",
			"url": "packages/global-packages/packages/features-library/*",
			"options": {
				"symlink": true
			}
		},
		{
			"type": "path",
			"url": "packages/global-packages/packages/blocks-pro/*",
			"options": {
				"symlink": true
			}
		}
	],
	"authors": [
		{
			"name": "The Blockera Contributors"
		}
	],
	"minimum-stability": "dev",
	"require": {
		"php": ">=7.4",
		"blockera/auth": "*",
		"blockera/auth-pro": "*",
		"blockera/blockera": "*",
		"blockera/blockera-admin": "*",
		"blockera/blockera-one": "*",
		"blockera/blockera-pro": "*",
		"blockera/blockera-pro-admin": "*",
		"blockera/blocks-core": "*",
		"blockera/bootstrap": "*",
		"blockera/classnames": "*",
		"blockera/controls": "*",
		"blockera/data": "*",
		"blockera/data-editor": "*",
		"blockera/editor": "*",
		"blockera/editor-pro": "*",
		"blockera/env": "*",
		"blockera/exceptions": "*",
		"blockera/feature-icon": "*",
		"blockera/features-core": "*",
		"blockera/global-styles-ui": "*",
		"blockera/guard-pro": "*",
		"blockera/http": "*",
		"blockera/icons": "*",
		"blockera/interact": "*",
		"blockera/plugin-compatibility": "*",
		"blockera/plugin-compatibility-pro": "*",
		"blockera/products": "*",
		"blockera/storage": "*",
		"blockera/telemetry": "*",
		"blockera/utils": "*",
		"blockera/wordpress": "*",
		"league/oauth2-client": "dev-master",
		"vlucas/phpdotenv": "^5.5@dev",
		"voku/simple_html_dom": "dev-master",
		"enshrined/svg-sanitize": "^0.22"
	},
	"require-dev": {
		"blockera/dev-tools": "*",
		"blockera/dev-cypress": "*",
		"blockera/dev-phpunit": "*",
		"symfony/dom-crawler": "5.4.x-dev",
		"symfony/css-selector": "5.4.x-dev",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.5.21",
		"squizlabs/php_codesniffer": "^3.13.5",
		"wp-cli/wp-cli-bundle": "^2.4",
		"wp-coding-standards/wpcs": "^3.4.1",
		"wp-phpunit/wp-phpunit": "dev-master",
		"filp/whoops": "^2.15",
		"yoast/phpunit-polyfills": "^2.0@dev",
		"symfony/var-dumper": "5.4.x-dev",
		"spatie/phpunit-snapshot-assertions": "v4.x-dev",
		"phpstan/phpstan": "2.1.x-dev",
		"php-stubs/wordpress-stubs": "dev-master",
		"10up/wp_mock": "dev-trunk",
		"brain/monkey": "^2.0@dev",
		"mockery/mockery": "1.7.x-dev"
	},
	"config": {
		"process-timeout": 0,
		"platform": {
			"php": "7.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"cweagans/composer-patches": true
		}
	},
	"scripts": {
		"test": "@php ./vendor/bin/phpunit",
		"lint": "./bin/phpcs.sh --standard=phpcs.xml",
		"format": "phpcbf --standard=phpcs.xml --report-summary --report-source",
		"test:coverage": "@php ./vendor/bin/phpunit --coverage-html php-coverage",
		"phpcs": "./bin/phpcs.sh",
		"phpcbf": "phpcbf"
	},
	"autoload-dev": {
		"psr-4": {
			"Blockera\\Tests\\": "tests/phpunit/main/"
		},
		"files": [
			"tests/phpunit/main/helpers.php"
		]
	},
	"optimize-autoloader": "true",
	"apcu-autoloader": true,
	"classmap-authoritative": true
}
