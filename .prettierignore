# Edit packages/global-packages/packages/dev-tools/root-configs/.prettierignore
# project:bootstrap copies this to the host repo root.

# Ignore artifacts:
dist
example
vendor
source-codes
Scratch
artifacts
test-results

# Generated from theme-config/ via npm run theme-json:merge — keep merge output byte-stable.
theme.json

# Generated icon search indexes — keep machine output byte-stable.
**/icons/js/search-index.json
**/icons/js/search-index-2.json

# Snapshot/fixture HTML uses block-markup prettier (npm run block-markup:prettier), not Prettier on save.
tests/fixtures/**/*.html
tests/fixtures/**/*.css

# Ignore theme patterns and templates files
templates/**/*.html
patterns/**/*.php

