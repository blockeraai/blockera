# Edit packages/dev-tools/root-configs/.docker/Dockerfile.wordpress
# (consumers: packages/global-packages/packages/dev-tools/root-configs/.docker/).
# project:bootstrap copies this folder to the host `.docker/`.
#
# Source of truth for apt-get flags injected into wp-env's generated
# WordPress.Dockerfile and Tests-WordPress.Dockerfile (see
# github/scripts/inject-wp-env-dockerfile.js). wp-env still chooses
# FROM wordpress:php${phpVersion} from .wp-env.json; this ARG is for
# manual builds of this file.
#
# Wipe apt lists then update+install in one layer. Cached WordPress image
# layers leave InRelease Hits that still 404 debian-security pool files
# (e.g. sudo on bullseye / wordpress:php7.4).

ARG PHP_VERSION=8.2
FROM wordpress:php${PHP_VERSION}

RUN rm -rf /var/lib/apt/lists/* && \
	apt-get update --allow-releaseinfo-change && \
	apt-get -qy install -o Apt::Get::AllowUnauthenticated=true -o Acquire::Retries=5 \
		$PHPIZE_DEPS && \
	touch /usr/local/etc/php/php.ini
