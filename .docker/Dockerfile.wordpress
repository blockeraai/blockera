# Edit packages/dev-tools/root-configs/.docker/Dockerfile.wordpress
# (consumers: packages/global-packages/packages/dev-tools/root-configs/.docker/).
# project:bootstrap copies this folder to the host `.docker/`.
#
# Source of truth for apt-get flags injected into wp-env's generated
# WordPress.Dockerfile and Tests-WordPress.Dockerfile (see
# github/scripts/inject-wp-env-dockerfile.js). wp-env still chooses
# FROM wordpress:php${phpVersion} from .wp-env.json; this ARG is for
# manual builds of this file.
#
# Retarget apt off deb.debian.org (Fastly POPs 404 debian-security pool
# files). EOL suites (stretch, buster, bullseye — LTS ended 2026-08-31)
# use archive.debian.org; current suites use ftp.debian.org /
# security.debian.org. Ignore expired InRelease files, wipe lists, update,
# and install.

ARG PHP_VERSION=8.2
FROM wordpress:php${PHP_VERSION}

RUN . /etc/os-release && \
	if echo "${VERSION_CODENAME}" | grep -Eq '^(stretch|buster|bullseye)$'; then \
		find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
			-e 's|https\?://[^/]*/debian-security|http://archive.debian.org/debian-security|g' \
			-e 's|https\?://deb.debian.org/debian|http://archive.debian.org/debian|g' \
			-e 's|https\?://ftp.debian.org/debian|http://archive.debian.org/debian|g' \
			-e 's|https\?://security.debian.org\(/debian-security\)\?|http://archive.debian.org/debian-security|g' \
			{} +; \
	else \
		find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i \
			-e 's|https\?://deb.debian.org/debian-security|http://security.debian.org/debian-security|g' \
			-e 's|https\?://deb.debian.org/debian|http://ftp.debian.org/debian|g' \
			{} +; \
	fi && \
	rm -rf /var/lib/apt/lists/* && \
	apt-get -o Acquire::Check-Valid-Until=false update --allow-releaseinfo-change && \
	apt-get -qy install -o Apt::Get::AllowUnauthenticated=true -o Acquire::Retries=5 \
		$PHPIZE_DEPS && \
	touch /usr/local/etc/php/php.ini
